# Copy these commands into your terminal. Do not commit your real API key.

# Option A: Qwen / DashScope API.
export DASHSCOPE_API_KEY="sk-your-dashscope-api-key"
export SLIDE_AOI_LLM_MODEL="qwen-vl-plus"

# Option B: OpenAI API.
# export OPENAI_API_KEY="sk-your-openai-api-key"
# export SLIDE_AOI_LLM_MODEL="gpt-4o-mini"

# Optional. Keep the default model or change it if your account/project uses another vision-capable model.
# You can also use QWEN_MODEL or OPENAI_MODEL.

# Optional. Reduce API image cost by limiting the longest side of the slide image.
export SLIDE_AOI_LLM_MAX_IMAGE_SIDE="1280"

# Optional. Use these only if your team deploys its own OpenAI-compatible model server.
# export SLIDE_AOI_LLM_ENDPOINT="http://your-server:8000/v1/chat/completions"
# export SLIDE_AOI_LLM_API_KEY="your-server-key-if-needed"
